{
  "name": "maketree-extension",
  "displayName": "MakeTree",
  "description": "Convert Markdown tree diagrams into real project files instantly and export project structures back to Markdown.",
  "version": "1.0.0",
  "publisher": "MarceloGenaizir",
  "icon": "media/icon.png",
  "license": "MIT",
  "main": "./extension.js",
  "bin": {
    "mktree": "./bin/cli.js"
  },
  "keywords": [
    "markdown",
    "tree",
    "scaffold",
    "cli",
    "architecture",
    "folder-structure",
    "generator"
  ],
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=14.0.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "maketree.createFromMarkdown",
        "title": "MakeTree: Generar carpetas desde Markdown"
      },
      {
        "command": "maketree.exportToMarkdown",
        "title": "MakeTree: Exportar estructura actual a Markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "maketree.createFromMarkdown",
          "when": "resourceExtname == .md",
          "group": "7_modification"
        },
        {
          "command": "maketree.exportToMarkdown",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "test": "uvu tests .test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "uvu": "^0.5.6"
  },
  "dependencies": {}
}
